# ==============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================
# Copy file này thành .env.production trên VPS
# Copy file này thành .env.local cho development
# ==============================================

# --- Database ---
DATABASE_URL=postgresql://user:password@postgres:5432/ttn_db
PORT=4000

# --- Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-this
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# --- MinIO Storage ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ttn-bucket
MINIO_USE_SSL=false
# Production: https://timviec.vieclamhr.com/ttn-bucket
# Development: http://localhost:9000/ttn-bucket
MINIO_PUBLIC_URL=http://localhost:9000/ttn-bucket

# --- AI Configuration ---
AI_API_KEY=your-gemini-api-key
AI_EMBEDDING_MODEL=text-embedding-004
AI_CHAT_MODEL=gemini-2.5-flash-lite

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Google Indexing API (Service Account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- CORS Configuration ---
# Comma-separated list of allowed origins
# Production: https://timviec.vieclamhr.com,https://vieclamhr.com
# Development: http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend Configuration ---
# Public API Endpoint (accessible from browser)
# Production: https://timviec.vieclamhr.com/api
# Development: http://localhost:4000 hoặc /api nếu dùng proxy
NEXT_PUBLIC_API_ENDPOINT=http://localhost:4000

# Public App URL
# Production: https://timviec.vieclamhr.com
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Google Client ID (for OAuth in browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Internal API URL for Server-Side Rendering (Docker network)
# Production: http://backend:4000
# Development: http://localhost:4000
INTERNAL_API_URL=http://localhost:4000
