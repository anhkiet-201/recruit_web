generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  engineType      = "client"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        String                      @id @default(uuid())
  email     String                      @unique
  password  String? // Hashed password
  role      String // 'candidate' | 'admin'
  name      String?
  phone     String?
  address   String?
  education String?
  skills    String? // Store as comma-separated or JSON string
  cvUrl     String?
  avatarUrl String?
  createdAt DateTime                    @default(now())
  embedding Unsupported("vector(768)")?

  applications     Application[]
  searchHistories  SearchHistory[]
  jobs             Job[]             @relation("JobAuthor")
  employerRequests EmployerRequest[]
}

model Guest {
  id              String          @id @default(uuid()) @db.Uuid
  lastActive      DateTime        @default(now())
  createdAt       DateTime        @default(now())
  searchHistories SearchHistory[]
}

model SearchHistory {
  id        String                      @id @default(uuid()) @db.Uuid
  userId    String?
  guestId   String?                     @db.Uuid
  query     String
  createdAt DateTime                    @default(now())
  embedding Unsupported("vector(768)")?

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model EmployerRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JobStatus {
  DRAFT
  ACTIVE
  EXPIRED
  REVIEWING
  ACCEPTED
  REJECTED
}

model Job {
  id              String                      @id // Removed @default(uuid()) @db.Uuid to allow custom string IDs
  title           String
  content         String
  location        String
  salaryMin       Int?
  salaryMax       Int?
  experienceYears Int?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime?                   @updatedAt
  deadline        DateTime?
  status          JobStatus                   @default(DRAFT)
  imageUrl        String?
  jobType         String? // 'unskilled' | 'skilled' | 'professional'
  views           Int                         @default(0)
  embedding       Unsupported("vector(768)")?
  authorId        String?

  applications Application[]
  jobTags      JobTag[]
  author       User?         @relation("JobAuthor", fields: [authorId], references: [id])
}

model Application {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String // Removed @db.Uuid to match Job.id
  userId    String
  cvUrl     String
  status    String   @default("pending") // 'pending' | 'reviewed' | 'rejected' | 'accepted' | 'expired'
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  jobTags JobTag[]
}

model JobTag {
  jobId String // Removed @db.Uuid to match Job.id
  tagId String @db.Uuid

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
}
