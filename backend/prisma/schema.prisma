generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // Hashed password
  role      String   // 'candidate' | 'admin'
  name      String?
  phone     String?
  address   String?
  education String?
  skills    String?  // Store as comma-separated or JSON string
  cvUrl     String?
  avatarUrl String?
  createdAt DateTime @default(now())

  applications Application[]
}

model Job {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  content         String
  location        String
  salaryMin       Int?
  salaryMax       Int?
  experienceYears Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt
  deadline        DateTime? // New field for expiration
  isActive        Boolean  @default(true)
  imageUrl        String?
  jobType         String?  // 'unskilled' | 'skilled' | 'professional'
  views           Int      @default(0)

  applications    Application[]
  jobTags         JobTag[]
}

model Application {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  userId    String
  cvUrl     String
  status    String   @default("pending") // 'pending' | 'reviewed' | 'rejected' | 'accepted'
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Tag {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique

  jobTags JobTag[]
}

model JobTag {
  jobId String @db.Uuid
  tagId String @db.Uuid

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
}
