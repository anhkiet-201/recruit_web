FROM node:20-alpine AS builder

RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Copy package files và prisma schema
COPY package*.json ./
COPY prisma ./prisma/

RUN npm install

# Copy source code (KHÔNG copy .env - sẽ inject runtime)
COPY . .

# Generate Prisma Client và build
RUN npx prisma generate
RUN npm run build

# --- Production Stage ---
FROM node:20-alpine

RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Copy artifacts từ builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./
COPY --from=builder /app/tsconfig.json ./
COPY --from=builder /app/src/ai/prompts ./prompts

EXPOSE 4000

# IMPORTANT: Environment variables sẽ được inject bởi Docker Compose
# Không hardcode .env vào image để đảm bảo security và flexibility

CMD [ "/bin/sh", "-c", "npx prisma migrate deploy && npx prisma db seed && npm run start:prod" ]
